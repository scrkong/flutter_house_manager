          children: [
            Container(
              width: 24,
              height: 24,
              child: Image.asset(
                icon,
                errorBuilder: (context, error, stackTrace) {
                  return Icon(
                    Icons.home,
                    size: 24,
                    color: Colors.blue,
                  );
                },
              ),
            ),
            SizedBox(width: 15),
            Expanded(
              child: Text(
                title,
                style: TextStyle(
